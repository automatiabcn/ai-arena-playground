# ============================================================
# AI Arena Playground — Configuration
# ============================================================
# You DON'T need all providers. Groq + Ollama are FREE.
# Add only the ones you want to compare.

# Database (SQLite for dev — no setup needed)
DATABASE_URL="file:./dev.db"

# ============================================================
# FREE PROVIDERS (no cost, no credit card)
# ============================================================

# Groq (free tier — get key at https://console.groq.com)
GROQ_API_KEY=""

# Ollama (free local — install from https://ollama.com)
OLLAMA_BASE_URL="http://localhost:11434"

# ============================================================
# PAID PROVIDERS (optional — add the ones you use)
# ============================================================

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=""

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=""

# Google Gemini (https://aistudio.google.com/apikey)
GOOGLE_AI_API_KEY=""

# Mistral (https://console.mistral.ai)
MISTRAL_API_KEY=""
