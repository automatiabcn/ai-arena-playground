{
  "name": "ai-arena-playground",
  "version": "1.0.0",
  "description": "Compare AI models side by side. Free, open-source, self-hosted.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "node -e \"const f=require('fs'); if(!f.existsSync('.env'))f.copyFileSync('.env.example','.env')\" && prisma db push && tsx --env-file=.env prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^6.1.0",
    "lucide-react": "^0.460.0",
    "next": "^14.2.15",
    "next-themes": "^0.4.3",
    "openai": "^4.70.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "postcss": "^8.4.47",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
