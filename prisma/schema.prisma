generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Comparison {
  id        String   @id @default(cuid())
  prompt    String
  category  String?
  createdAt DateTime @default(now())
  responses Response[]
}

model Response {
  id           String     @id @default(cuid())
  comparisonId String
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  provider     String
  model        String
  content      String
  latencyMs    Int
  inputTokens  Int        @default(0)
  outputTokens Int        @default(0)
  costUsd      Float      @default(0)
  error        String?
  createdAt    DateTime   @default(now())

  @@index([comparisonId])
}

model ModelStat {
  id           String @id @default(cuid())
  provider     String
  model        String
  category     String @default("general")
  totalRuns    Int    @default(0)
  avgLatencyMs Float  @default(0)
  avgCostUsd   Float  @default(0)
  avgTokens    Float  @default(0)
  winCount     Int    @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([provider, model, category])
}

model Setting {
  key   String @id
  value String
}
